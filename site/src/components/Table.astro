---
// The site's main navigation: threads as rows, IAD levels as columns.
// mode "pieces" lists essays per cell; mode "patterns" lists patterns per cell.
import Mark from './Mark.astro';
import Num from './Num.astro';
import { site, url, newFileUrl, type ColumnId } from '../lib/content';
import { THREADS, COLUMNS } from '../lib/site.mjs';
import fs from 'node:fs';
import path from 'node:path';

interface Props { mode: 'pieces' | 'patterns'; threads?: string[] }
const { mode, threads } = Astro.props;
const { table, patternTable } = await site();
const rows = THREADS.filter((t) => !threads || threads.includes(t.id));

const templateFile: Record<ColumnId, string> = { guides: 'guide.md', governance: 'governance.md', theory: 'theory.md' };
const template = (col: ColumnId, thread: string) =>
  fs.readFileSync(path.resolve(process.cwd(), '../templates', templateFile[col]), 'utf8').replace(/^threads: \[\]/m, `threads: [${thread}]`);
---
<div class="table-wrap">
  <table class={`the-table the-table--${mode}`}>
    <thead>
      <tr>
        <th scope="col" class="corner"><span class="visually-hidden">Thread</span></th>
        {COLUMNS.map((c) => (
          <th scope="col">
            <span class="col-name"><Mark shape={c.mark as any} />{c.name}</span>
            <span class="level">{c.levelLabel}</span>
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((t) => (
        <tr style={`--thread:${t.ink}`}>
          <th scope="row"><a href={url.thread(t.id)}><Mark shape="circle" color={t.ink} />{t.name}</a></th>
          {COLUMNS.map((c) => {
            const col = c.id as ColumnId;
            if (mode === 'patterns') {
              const items = patternTable[t.id][col];
              return (
                <td data-label={c.name}>
                  {items.length ? (
                    <ul>{items.map((p) => <li><a class="pattern-link" href={url.pattern(p)}><Num n={p.data.number} ink={t.ink} /><span>{p.data.title}</span></a></li>)}</ul>
                  ) : <span class="empty">None yet</span>}
                </td>
              );
            }
            const items = table[t.id][col];
            return (
              <td data-label={c.name} class={items.length ? undefined : 'is-open'}>
                {items.length ? (
                  <ul>{items.map((p) => <li><a href={url.piece(p)}>{p.data.title}</a></li>)}</ul>
                ) : (
                  <a class="write-here" href={newFileUrl(col, 'new-piece.md', template(col, t.id))} rel="noopener">Write this piece</a>
                )}
              </td>
            );
          })}
        </tr>
      ))}
    </tbody>
  </table>
</div>
