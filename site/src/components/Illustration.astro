---
// Inlines a pattern's sketch so it takes the page's ink and the thread's pencil color.
import fs from 'node:fs';
import path from 'node:path';
interface Props { file: string; ink: string; n: number }
const { file, ink, n } = Astro.props;
const svg = fs.readFileSync(path.resolve(process.cwd(), '../wiki/patterns', file), 'utf8');
---
<figure class="plate" style={`--thread:${ink}`}>
  <Fragment set:html={svg} />
  <figcaption>Fig. {n}</figcaption>
</figure>
