---
// A small two-color stamp: a color shape printed slightly off-register under an ink outline.
// Circles mark threads; square, triangle, and diamond mark the three columns (levels).
interface Props { shape: 'circle' | 'square' | 'triangle' | 'diamond'; color?: string; label?: string }
const { shape, color = 'var(--ink-soft)', label } = Astro.props;
const d = {
  circle: 'M10 3a7 7 0 1 1 0 14a7 7 0 1 1 0-14Z',
  square: 'M3.5 3.5h13v13h-13Z',
  triangle: 'M10 2.5L17.5 16.5H2.5Z',
  diamond: 'M10 2L18 10L10 18L2 10Z',
}[shape];
---
<svg class="mark" viewBox="0 0 20 20" width="20" height="20" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  <path d={d} transform="translate(1.6 1.4)" style={`fill:${color}`} />
  <path d={d} fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
</svg>
