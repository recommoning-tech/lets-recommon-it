---
// Hand-drawn mark. Circles are thread swatches, hatched in the thread's colored pencil;
// square, triangle, and diamond mark the three columns (levels). Roughened by the #rough filter.
interface Props { shape: 'circle' | 'square' | 'triangle' | 'diamond'; color?: string; label?: string }
const { shape, color, label } = Astro.props;
const d = {
  circle: 'M10 3.2c4.2-.3 7.1 2.8 6.8 6.9-.2 3.9-3.4 6.8-7.1 6.6-3.8-.2-6.6-3.3-6.4-7 .2-3.7 3.1-6.6 6.9-6.6',
  square: 'M3.4 3.8l13.2-.4.3 12.9-13.3.2z',
  triangle: 'M10 2.6l7.6 13.6-15.3.3z',
  diamond: 'M10 2.2l7.9 7.9-7.9 7.8-7.8-7.9z',
}[shape];
---
<svg class="mark" viewBox="0 0 20 20" width="20" height="20" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  <g filter="url(#rough)">
    {color && <path d="M4 15L15 4M3 11L11 3M7 17L17 7M10 17.5L17.5 10" stroke={color} stroke-width="1.6" stroke-linecap="round" fill="none" />}
    <path d={d} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" />
  </g>
</svg>
