---
import '@fontsource/courier-prime/400.css';
import '@fontsource/courier-prime/400-italic.css';
import '@fontsource/courier-prime/700.css';
import '@fontsource/architects-daughter/400.css';
import '../styles/global.css';
import EditLink from '../components/EditLink.astro';
import { BASE, REPO_URL } from '../lib/site.mjs';

interface Props { title: string; description?: string; edit?: string }
const { title, description = 'Guides, governance, and theory for community-scale IT, run as a commons.', edit } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: BASE, label: 'The table' },
  { href: `${BASE}patterns/`, label: 'Patterns' },
  { href: `${BASE}bibliography/`, label: 'Bibliography' },
  { href: `${BASE}guides/contributing/`, label: 'Contribute' },
];
const pageTitle = title === "Let's Recommon IT" ? title : `${title} | Let's Recommon IT`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${BASE}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <!-- Shared filter that makes drawn marks look hand-made. -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <filter id="rough" x="-10%" y="-10%" width="120%" height="120%">
        <feTurbulence type="fractalNoise" baseFrequency="0.05" numOctaves="2" seed="7" />
        <feDisplacementMap in="SourceGraphic" scale="2.2" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="site-name" href={BASE}>Let's Recommon IT</a>
      <nav aria-label="Main">
        {nav.map((n) => (
          <a href={n.href} aria-current={(n.href === BASE ? path === BASE : path.startsWith(n.href)) ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
    </header>
    <main id="main">
      <slot />
      {edit && <p class="page-edit"><EditLink href={edit} label="Mark up this page on GitHub" /></p>}
    </main>
    <footer class="site-footer">
      <p class="typed-rule" aria-hidden="true">* * *</p>
      <p>cc: everyone. Writing is <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a> and code is <a href="https://opensource.org/license/mit">MIT</a>, so all of it can be copied, changed, and shared back.</p>
      <p><a href={REPO_URL}>Source and contributions on GitHub</a></p>
    </footer>
  </body>
</html>
