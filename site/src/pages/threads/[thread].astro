---
import Base from '../../layouts/Base.astro';
import Table from '../../components/Table.astro';
import { THREADS } from '../../lib/site.mjs';
import { site, url } from '../../lib/content';

export function getStaticPaths() {
  return THREADS.map((t) => ({ params: { thread: t.id }, props: { thread: t } }));
}
const { thread } = Astro.props;
const { patterns } = await site();
const own = patterns.filter((p) => p.data.thread === thread.id);
---
<Base title={thread.name} description={thread.claim}>
  <p class="crumbs"><a href={import.meta.env.BASE_URL}>The table</a> › Thread</p>
  <h1>{thread.name}</h1>
  <p class="lede">{thread.claim}</p>
  <h2>Pieces</h2>
  <Table mode="pieces" threads={[thread.id]} />
  <h2>Patterns</h2>
  {own.length ? (
    <ul class="pattern-list">
      {own.map((p) => <li><a href={url.pattern(p)}><span class="num">{p.data.number}</span> {p.data.title}</a> <span class="intro">{p.data.introduction}</span></li>)}
    </ul>
  ) : <p>No patterns in this thread yet.</p>}
</Base>
