---
import Base from '../../layouts/Base.astro';
import Table from '../../components/Table.astro';
import Mark from '../../components/Mark.astro';
import Num from '../../components/Num.astro';
import { THREADS } from '../../lib/site.mjs';
import { site, url } from '../../lib/content';

export function getStaticPaths() {
  return THREADS.map((t) => ({ params: { thread: t.id }, props: { thread: t } }));
}
const { thread } = Astro.props;
const { patterns } = await site();
const own = patterns.filter((p) => p.data.thread === thread.id);
---
<Base title={thread.name} description={thread.claim}>
  <nav class="crumbs" aria-label="Breadcrumb"><a href={import.meta.env.BASE_URL}>The table</a></nav>
  <h1 class="with-mark"><Mark shape="circle" color={thread.ink} />{thread.name}</h1>
  <p class="lede">{thread.claim}</p>
  <h2 class="page-h2">Pieces</h2>
  <Table mode="pieces" threads={[thread.id]} />
  <h2 class="page-h2">Patterns</h2>
  {own.length ? (
    <ul class="pattern-index">
      {own.map((p) => <li><Num n={p.data.number} /><div><a href={url.pattern(p)}>{p.data.title}</a><p class="intro">{p.data.introduction}</p></div></li>)}
    </ul>
  ) : <p class="empty">No patterns in this thread yet.</p>}
</Base>
