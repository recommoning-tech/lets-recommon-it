---
import Base from '../../layouts/Base.astro';
import Mark from '../../components/Mark.astro';
import Num from '../../components/Num.astro';
import Illustration from '../../components/Illustration.astro';
import { render } from 'astro:content';
import { site, url, editUrl, columnOf, threadOf, repoPath, type Pattern } from '../../lib/content';

export async function getStaticPaths() {
  const { patterns } = await site();
  return patterns.map((p) => ({ params: { slug: p.id }, props: { pattern: p } }));
}
const { pattern } = Astro.props as { pattern: Pattern };
const { pieceByPath, patternById } = await site();
const { Content } = await render(pattern);
const d = pattern.data;
const thread = threadOf(d.thread)!;
const column = columnOf(d.level);
const intro = d.introduced_in ? pieceByPath.get(d.introduced_in) : undefined;
const applied = d.applied_in.map((a) => pieceByPath.get(a)).filter((p) => p !== undefined);
const rel = (ids: string[]) => ids.map((id) => patternById.get(id)).filter((p) => p !== undefined);
const larger = rel(d.larger_patterns);
const smaller = rel(d.smaller_patterns);
---
<Base title={d.title} description={d.introduction} edit={editUrl(pattern)}>
  <article class="pattern" style={`--thread:${thread.ink}`}>
    <header class="memo">
      <div class="pattern-title"><Num n={d.number} /><h1>{d.title}</h1></div>
      <p class="pattern-intro">{d.introduction}</p>
      <dl class="memo-fields">
        <dt>Thread:</dt>
        <dd><span class="tag"><Mark shape="circle" color={thread.ink} /><a href={url.thread(d.thread)}>{thread.name}</a></span></dd>
        <dt>Level:</dt>
        <dd><span class="tag"><Mark shape={column.mark as any} />{d.level}</span>, in the {column.name.toLowerCase()} column</dd>
        <dt>File:</dt>
        <dd><code>{repoPath(pattern)}</code></dd>
      </dl>
      <div class="margin-notes">
        {d.status === 'draft' && <p class="note note--draft">draft</p>}
        {intro ? <p class="note">explained in <a href={url.piece(intro)}>{intro.data.title}</a></p> : <p class="note">no piece explains this yet: write one?</p>}
      </div>
    </header>
    {d.image && <Illustration file={d.image} ink={thread.ink} n={d.number} />}
    <div class="pattern-body"><Content /></div>
    <aside class="connections" aria-label="Connections">
      <h2>Connections</h2>
      <dl>
        <dt>Introduced in</dt>
        <dd>{intro ? <a href={url.piece(intro)}>{intro.data.title}</a> : <span class="empty">not written yet: a {column.name.toLowerCase()} piece in this thread</span>}</dd>
        <dt>Applied in</dt>
        <dd>{applied.length ? applied.map((p, i) => <>{i > 0 && ', '}<a href={url.piece(p)}>{p.data.title}</a></>) : <span class="empty">not applied elsewhere yet</span>}</dd>
        <dt>Larger patterns</dt>
        <dd>{larger.length ? larger.map((p, i) => <>{i > 0 && ', '}<a href={url.pattern(p)}>{p.data.title}</a></>) : <span class="empty">none yet</span>}</dd>
        <dt>Smaller patterns</dt>
        <dd>{smaller.length ? smaller.map((p, i) => <>{i > 0 && ', '}<a href={url.pattern(p)}>{p.data.title}</a></>) : <span class="empty">none yet</span>}</dd>
      </dl>
    </aside>
  </article>
</Base>
