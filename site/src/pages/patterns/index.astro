---
import Base from '../../layouts/Base.astro';
import Table from '../../components/Table.astro';
import Mark from '../../components/Mark.astro';
import Num from '../../components/Num.astro';
import { site, url, columnOf, threadOf, newFileUrl } from '../../lib/content';
import { BASE } from '../../lib/site.mjs';
import fs from 'node:fs';
import path from 'node:path';

const { patterns } = await site();
const template = fs.readFileSync(path.resolve(process.cwd(), '../templates/wiki-pattern.md'), 'utf8');
---
<Base title="Patterns" description="A pattern language for community tech.">
  <h1>Patterns</h1>
  <p class="lede">A pattern names a problem that keeps coming up and says what to do about it. Together they form a language for building and running technology in common.</p>
  <p class="actions"><a href={`${BASE}theory/a-pattern-language-for-community-tech/`}>About the patterns</a> <a href={`${BASE}guides/writing-a-pattern/`}>How to write one</a> <a href={newFileUrl('wiki/patterns', 'new-pattern.md', template)} rel="noopener">Start a pattern on GitHub</a></p>
  <Table mode="patterns" />
  <h2 class="page-h2">All patterns</h2>
  <ol class="pattern-index">
    {patterns.map((p) => {
      const t = threadOf(p.data.thread)!;
      const c = columnOf(p.data.level);
      return (
        <li>
          <Num n={p.data.number} />
          <div>
            <a href={url.pattern(p)}>{p.data.title}</a>
            <p class="intro">{p.data.introduction}</p>
            <p class="meta"><span class="tag"><Mark shape="circle" color={t.ink} /><a href={url.thread(t.id)}>{t.name}</a></span> <span class="tag"><Mark shape={c.mark as any} />{p.data.level}</span></p>
          </div>
        </li>
      );
    })}
  </ol>
</Base>
