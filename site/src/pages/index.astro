---
import Base from '../layouts/Base.astro';
import Table from '../components/Table.astro';
import Mark from '../components/Mark.astro';
import { BASE } from '../lib/site.mjs';
---
<Base title="Let's Recommon IT">
  <section class="hero">
    <h1 class="hero-title">Let's Recommon IT</h1>
    <dl class="memo-fields">
      <dt>Re:</dt>
      <dd>Guides, governance, and theory for running technology at community scale, so it's owned, understood, and governed by the people who use it.</dd>
      <dt>To:</dt>
      <dd>Anyone who runs, or wants to run, technology with other people.</dd>
    </dl>
  </section>
  <Table mode="pieces" />
  <section class="key" aria-label="How to read the table">
    <p><Mark shape="circle" color="var(--ink-soft)" /> Each row is a thread: a topic, from institutions to AI.</p>
    <p><Mark shape="square" /> <Mark shape="triangle" /> <Mark shape="diamond" /> Each column is a level of rules from Elinor Ostrom's institutional analysis: guides for day-to-day work, governance for how rules are made and who makes them, theory for what it's all for. <a href={`${BASE}theory/this-repository-is-a-commons/`}>Why the site is built this way</a>.</p>
    <p>Every piece explains a set of <a href={`${BASE}patterns/`}>patterns</a>. Anyone can write an open cell.</p>
  </section>
</Base>
