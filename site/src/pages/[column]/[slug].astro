---
// Guides, governance pieces, and theory essays share one layout, set as a typed memo.
import Base from '../../layouts/Base.astro';
import Mark from '../../components/Mark.astro';
import { render } from 'astro:content';
import { site, url, threadOf, editUrl, repoPath, type Piece, type ColumnId } from '../../lib/content';
import { COLUMNS } from '../../lib/site.mjs';

export async function getStaticPaths() {
  const { pieces } = await site();
  return pieces.map((p) => ({ params: { column: p.collection, slug: p.id }, props: { piece: p } }));
}
const { piece } = Astro.props as { piece: Piece };
const { table, sourceById, patternById } = await site();
const { Content } = await render(piece);
const d = piece.data;
const thread = threadOf(d.threads[0])!;
const column = COLUMNS.find((c) => c.id === piece.collection)!;
const row = table[thread.id];
const sources = d.sources.map((s) => sourceById.get(s.replace(/\.md$/, ''))).filter((s) => s !== undefined);
const pats = (refs: string[]) => refs.map((r) => patternById.get(r.replace(/^.*\//, '').replace(/\.md$/, ''))).filter((p) => p !== undefined);
const introduced = pats(d.patterns);
const applied = pats(d.patterns_applied);
---
<Base title={d.title} edit={editUrl(piece)}>
  <article class="piece" style={`--thread:${thread.ink}`}>
    <header class="memo">
      <dl class="memo-fields">
        <dt>Re:</dt>
        <dd><h1>{d.title}</h1></dd>
        <dt>Thread:</dt>
        <dd><span class="tag"><Mark shape="circle" color={thread.ink} /><a href={url.thread(thread.id)}>{thread.name}</a></span></dd>
        <dt>Column:</dt>
        <dd><span class="tag"><Mark shape={column.mark as any} />{column.name}</span>, {column.levelLabel.toLowerCase()} level</dd>
        <dt>File:</dt>
        <dd><code>{repoPath(piece)}</code></dd>
      </dl>
      <div class="margin-notes">
        {d.status === 'draft' && <p class="note note--draft">draft</p>}
        {(introduced.length > 0 || applied.length > 0) && (
          <p class="note">
            {introduced.length > 0 && <>introduces {introduced.map((p, i) => <>{i > 0 && ', '}<a href={url.pattern(p)}>{p.data.title}</a></>)}</>}
            {introduced.length > 0 && applied.length > 0 && <br />}
            {applied.length > 0 && <>applies {applied.map((p, i) => <>{i > 0 && ', '}<a href={url.pattern(p)}>{p.data.title}</a></>)}</>}
          </p>
        )}
      </div>
    </header>
    <div class="prose"><Content /></div>
  </article>
  {sources.length > 0 && (
    <section class="sources">
      <h2>Sources</h2>
      <ul>{sources.map((s) => <li><a href={url.source(s)}>{s.data.title}</a>{s.data.authors.length > 0 && <>, {s.data.authors.join('; ')}</>}{s.data.year && <> ({s.data.year})</>}</li>)}</ul>
    </section>
  )}
  <nav class="in-thread" aria-label="Everything in this thread">
    <h2 class="with-mark"><Mark shape="circle" color={thread.ink} />Also in <a href={url.thread(thread.id)}>{thread.name}</a></h2>
    <div class="in-thread-cols">
      {COLUMNS.map((c) => (
        <div>
          <h3 class="with-mark"><Mark shape={c.mark as any} />{c.name}</h3>
          {row[c.id as ColumnId].length ? (
            <ul>{row[c.id as ColumnId].map((p) => <li>{p.id === piece.id && p.collection === piece.collection ? <span aria-current="page">{p.data.title} (this memo)</span> : <a href={url.piece(p)}>{p.data.title}</a>}</li>)}</ul>
          ) : <p class="empty">open</p>}
        </div>
      ))}
    </div>
  </nav>
</Base>
